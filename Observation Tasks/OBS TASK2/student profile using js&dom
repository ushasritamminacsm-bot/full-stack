<!DOCTYPE html>
<html>
<head>
    <title>Student Profile Manager</title>

    <style>
        body {
            font-family: Arial;
            text-align: center;
            background: #f2f2f2;
            margin: 30px;
        }

        input {
            padding: 8px;
            margin: 5px;
            width: 220px;
        }

        button {
            padding: 10px 20px;
            margin: 10px;
            background: royalblue;
            color: white;
            border: none;
            border-radius: 5px;
        }

        #profile {
            width: 300px;
            margin: 20px auto;
            padding: 20px;
            background: white;
            border: 2px solid royalblue;
            border-radius: 10px;
            box-shadow: 2px 2px 8px gray;
            text-align: left;
        }
    </style>
</head>

<body>

    <h1>Student Profile Manager</h1>

    <input type="text" id="name" placeholder="Name"><br>
    <input type="text" id="roll" placeholder="Roll Number"><br>
    <input type="text" id="department" placeholder="Department"><br>
    <input type="number" id="cgpa" placeholder="CGPA" step="0.01"><br>

    <button id="showBtn">Show Profile</button>

    <div id="profile"></div>

    <script>
        // Create Student class
        class Student {
            constructor(name, roll, department, cgpa) {
                this.name = name;
                this.roll = roll;
                this.department = department;
                this.cgpa = cgpa;
            }
        }

        // Button click event
        document.getElementById("showBtn").addEventListener("click", function() {

            // Get user input
            let student = new Student(
                document.getElementById("name").value,
                document.getElementById("roll").value,
                document.getElementById("department").value,
                document.getElementById("cgpa").value
            );

            // Select profile area
            let profile = document.getElementById("profile");
            profile.innerHTML = "";

            // Create elements dynamically
            let title = document.createElement("h2");
            title.textContent = "Student Profile";

            let details = document.createElement("p");
            details.innerHTML =
                "Name : " + student.name + "<br>" +
                "Roll No : " + student.roll + "<br>" +
                "Department : " + student.department + "<br>" +
                "CGPA : " + student.cgpa;

            // Add elements to webpage
            profile.appendChild(title);
            profile.appendChild(details);
        });
    </script>

</body>
</html>
