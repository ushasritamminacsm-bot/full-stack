<!DOCTYPE html>
<html>
<head>
    <title>My Styled Webpage</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #eee;
        }

        /* Header */
        header {
            padding: 20px;
            text-align: center;
            color: white;
            background: linear-gradient(to right, blue, skyblue);
            text-shadow: 2px 2px 3px black;
        }

        /* Navigation */
        nav {
            padding: 15px;
            text-align: center;
            background: #222;
        }

        nav a {
            color: white;
            margin: 15px;
            text-decoration: none;
        }

        nav a:hover {
            color: yellow;
        }

        /* Cards */
        .cards {
            display: flex;
            gap: 20px;
            margin: 30px;
        }

        .card {
            padding: 20px;
            background: white;
            border: 2px solid blue;
            border-radius: 12px;
            box-shadow: 3px 3px 8px gray;
            text-align: center;
        }

        button {
            padding: 8px 15px;
            border: 0;
            border-radius: 6px;
            background: blue;
            color: white;
        }

        button:hover {
            background: black;
        }

        /* Footer */
        footer {
            padding: 15px;
            text-align: center;
            background: #222;
            color: white;
        }
    </style>
</head>

<body>

<header>
    <h1>My Styled Webpage</h1>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Contact</a>
</nav>

<div class="cards">

    <div class="card">
        <h2>HTML5</h2>
        <p>Creates webpage structure.</p>
        <button>Learn More</button>
    </div>

    <div class="card">
        <h2>CSS3</h2>
        <p>Styles the webpage.</p>
        <button>Learn More</button>
    </div>

    <div class="card">
        <h2>Web Design</h2>
        <p>Makes websites attractive.</p>
        <button>Learn More</button>
    </div>

</div>

<footer>
    <p>© 2026 My Styled Webpage</p>
</footer>

</body>
</html>
