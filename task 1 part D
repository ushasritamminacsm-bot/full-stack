<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>College Information Portal</title>
</head>

<body>

    <!-- Semantic Elements -->
    <header>
        <h1>ANITS College Information Portal</h1>
    </header>

    <nav>
        <a href="#home">Home</a> |
        <a href="#about">About</a> |
        <a href="#media">Media</a>
    </nav>

    <section id="home">
        <h2>Welcome to ANITS</h2>
        <p>ANITS provides quality education in Engineering and Technology.</p>
    </section>

    <article id="about">
        <h2>About College</h2>
        <p>ANITS is located in Visakhapatnam and offers various engineering courses.</p>
    </article>

    <!-- HTML5 Input Types -->
    <section>
        <h2>Student Details</h2>

        Email:
        <input type="email"><br><br>

        Date:
        <input type="date"><br><br>

        Age:
        <input type="number" min="17" max="30"><br><br>

        Color:
        <input type="color"><br><br>

        Interest:
        <input type="range" min="0" max="10">
    </section>

    <!-- Audio and Video -->
    <section id="media">
        <h2>College Media</h2>

        <audio controls>
            <source src="college-audio.mp3" type="audio/mpeg">
        </audio>

        <br><br>

        <video width="400" controls>
            <source src="college-video.mp4" type="video/mp4">
        </video>
    </section>

    <footer>
        <p>&copy; 2026 ANITS College Information Portal</p>
    </footer>

</body>
</html>
