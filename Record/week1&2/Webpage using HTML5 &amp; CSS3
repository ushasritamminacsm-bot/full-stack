<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Webpage</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f2f2f2;
        }

        header {
            padding: 25px;
            text-align: center;
            color: white;
            background: linear-gradient(to right, royalblue, purple);
            text-shadow: 2px 2px 3px black;
        }

        nav {
            padding: 15px;
            text-align: center;
            background: #222;
        }

        nav a {
            color: white;
            margin: 15px;
            text-decoration: none;
        }

        nav a:hover {
            color: yellow;
        }

        section {
            display: flex;
            justify-content: center;
            gap: 20px;
            padding: 30px;
        }

        .card {
            width: 200px;
            padding: 20px;
            background: white;
            text-align: center;
            border: 2px solid royalblue;
            border-radius: 10px;
            box-shadow: 3px 3px 8px gray;
        }

        .card:hover {
            transform: scale(1.05);
        }

        button {
            padding: 8px 15px;
            background: royalblue;
            color: white;
            border: none;
            border-radius: 5px;
        }

        button:hover {
            background: black;
        }

        footer {
            padding: 15px;
            text-align: center;
            background: #222;
            color: white;
        }
    </style>
</head>

<body>

    <header>
        <h1>My HTML5 & CSS3 Webpage</h1>
        <p>Welcome to My Website</p>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">Services</a>
        <a href="#">Contact</a>
    </nav>

    <section>

        <div class="card">
            <h2>HTML5</h2>
            <p>HTML5 creates the structure of a webpage.</p>
            <button>Learn More</button>
        </div>

        <div class="card">
            <h2>CSS3</h2>
            <p>CSS3 makes webpages attractive.</p>
            <button>Learn More</button>
        </div>

        <div class="card">
            <h2>Web Design</h2>
            <p>Modern design improves user experience.</p>
            <button>Learn More</button>
        </div>

    </section>

    <footer>
        © 2026 My Webpage
    </footer>

</body>
</html>
